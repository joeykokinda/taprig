{
  "name": "taprig",
  "version": "0.1.0",
  "description": "Local-first control plane and runtime for Android phone agents",
  "author": {
    "name": "Joey Kokinda",
    "email": "joeykokinda@users.noreply.github.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/joeykokinda/taprig",
  "repository": "github:joeykokinda/taprig",
  "desktopName": "dev.taprig.desktop",
  "private": true,
  "type": "module",
  "main": "dist/desktop/main.js",
  "bin": {
    "taprig": "src/cli.ts"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "build:driver": "cd android-driver && ./gradlew --no-daemon test assembleRelease && node bundle.mjs",
    "build:desktop": "esbuild desktop/main.ts src/cli.ts --bundle --platform=node --format=esm --outdir=dist/desktop --entry-names=[name] --external:electron",
    "benchmark": "node src/benchmarks/runtime.ts",
    "soak": "node src/benchmarks/soak.ts",
    "check": "npm run lint && npm run typecheck && npm test",
    "desktop": "npm run build:desktop && electron .",
    "desktop:dist": "npm run build:desktop && electron-builder --linux AppImage deb",
    "desktop:pack": "npm run build:desktop && electron-builder --linux dir",
    "format": "biome check --write .",
    "lint": "biome check .",
    "taprig": "node src/cli.ts",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "build": {
    "appId": "dev.taprig.desktop",
    "productName": "TapRig",
    "artifactName": "${productName}-${version}-${os}-${arch}-unsigned.${ext}",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/desktop/**",
      "control-room/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "android-driver/build/bundle",
        "to": "android-driver"
      }
    ],
    "linux": {
      "icon": "build/icon.png",
      "syncDesktopName": true,
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    },
    "mac": {
      "icon": "build/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "26.6.6",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  }
}
