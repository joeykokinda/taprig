{
  "name": "taprig",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "taprig": "src/cli.ts"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "check": "npm run lint && npm run typecheck && npm test",
    "format": "biome check --write .",
    "lint": "biome check .",
    "taprig": "node src/cli.ts",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  }
}
